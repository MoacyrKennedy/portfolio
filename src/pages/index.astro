		<section class="wrap sec" aria-label="Outros projetos">
			<div class="sec-head" data-reveal>
				<span class="sec-num">(02)</span>
				<div>
					<p class="meta">Atuações anteriores</p>
					<h2 class="big-title">Outros <span class="em">projetos</span></h2>
				</div>
			</div>

			<div class="proj-grid">
				{outroProjetos.map((p) => (
					<article class="proj-card">
						<div class="proj-img">
							<img src={p.img} alt={p.title} loading="lazy" />
						</div>
						<div class="proj-body">
							<h3>{p.link ? <a href={p.link} target="_blank" rel="noopener">{p.title} ↗</a> : p.title}</h3>
							<p>{p.desc}</p>
							<div class="proj-tags">
								{p.tags.map((t) => <span>{t}</span>)}
							</div>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="wrap sec" id="experiencia" aria-label="Experiência profissional">
			<div class="sec-head" data-reveal>
				<span class="sec-num">(03)</span>
				<div>
					<p class="meta">Trajetória</p>
					<h2 class="big-title">Experiência <span class="em">profissional</span></h2>
				</div>
			</div>

			<div class="timeline">
				<div class="tl-line" aria-hidden="true"></div>
				{experiencias.map((e) => (
					<article class={`tl-item${e.atual ? ' current' : ''}`}>
						<div class="tl-year">{e.periodo}</div>
						<div class="tl-body">
							<h3 class="tl-role">{e.cargo} <span>— {e.empresa}</span></h3>
							<p>{e.texto}</p>
							<div class="tl-tech">
								{e.tech.map((t) => <span>{t}</span>)}
							</div>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="wrap sec" id="stack" aria-label="Habilidades técnicas">
			<div class="sec-head" data-reveal>
				<span class="sec-num">(04)</span>
				<div>
					<p class="meta">Hard skills & formação</p>
					<h2 class="big-title">Ferramentas que eu <span class="em">domino</span></h2>
				</div>
			</div>

			<div class="stack-grid">
				{stack.map((s) => (
					<div class="stack-cell">
						<h4>{s.title}</h4>
						<ul>
							{s.itens.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				))}
			</div>

			<div data-reveal>
				<p class="meta" style="margin-top:40px;">Formação & certificações</p>
				<div class="big-certs">
					<span>Bacharel em Eng. de Software — UNICESUMAR (CRA 9.0)</span>
					<span>LFS184 — JavaScript Security</span>
					<span>CC50 — Harvard</span>
					<span>Full Stack — Serratec/Senai (770h)</span>
					<span>Formação Full Stack — Desenvolvedor.io</span>
					<span>Java Spring Boot — Udemy</span>
				</div>
			</div>
		</section>
	</main>

	<footer class="wrap footer" id="contato" aria-label="Contato">
		<h2 class="cta-title"><a href="mailto:kenedytere@gmail.com">Vamos construir algo?</a></h2>

		<div class="footer-grid">
			<div class="footer-col">
