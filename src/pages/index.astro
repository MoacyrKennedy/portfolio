				<a href="https://wa.me/5521991875221?text=Ol%C3%A1%2C%20Moacyr!%20Vim%20pelo%20seu%20portf%C3%B3lio%20e%20gostaria%20de%20conversar%20sobre%20um%20projeto." target="_blank" rel="noopener">WhatsApp — +55 (21) 99187-5221</a>
			</div>
			<div class="footer-col">
				<h5>Redes</h5>
				<a href="https://linkedin.com/in/moacyrkennedy" target="_blank" rel="noopener">LinkedIn</a>
				<a href="https://github.com/MoacyrKennedy" target="_blank" rel="noopener">GitHub</a>
			</div>
			<div class="footer-col">
				<h5>Currículo</h5>
				<a href="/curriculo.pdf" download>Baixar PDF ↓</a>
			</div>
			<div class="footer-credit">© {new Date().getFullYear()} Moacyr Kennedy — feito com Astro, GSAP e Lenis.</div>
		</div>
	</footer>

	<div class="detective" role="status" aria-live="polite">
		<span class="detective-text"></span><span class="detective-caret">▍</span>
	</div>

	<script>import '../scripts/main.js'</script>
</body>
</html>